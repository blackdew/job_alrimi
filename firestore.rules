rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 일자리 정보 - 읽기만 허용
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if false; // 크롤러만 쓰기 (Admin SDK 사용)
    }

    // 빈집 정보 - 읽기만 허용
    match /houses/{houseId} {
      allow read: if true;
      allow write: if false; // 크롤러만 쓰기 (Admin SDK 사용)
    }

    // FCM 토큰 저장 (웹 푸시용)
    // 토큰은 푸시 수신만 가능하므로 보안 위험 낮음
    match /fcm_tokens/{tokenId} {
      allow read: if false; // 읽기 불허
      allow create, update: if true; // 쓰기만 허용
      allow delete: if false;
    }

    // 사용자 설정
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
